filters:
  and:
    - file.folder.contains("Campaign/Quests")
    - file.name != "Quests.base"
views:
  - type: table
    name: View
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - quest_giver
      - session_assigned
      - session_concluded
      - related_locations
