filters:
  and:
    - file.path.contains("People/")
    - met_party == true
views:
  - type: table
    name: View
    order:
      - file.name
      - species
      - familiarity
      - disposition
      - last_contact
      - occupation
      - related_locations
    sort:
      - property: last_contact
        direction: DESC
    columnSize:
      note.related_locations: 407
