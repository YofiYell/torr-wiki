filters:
  and:
    - file.folder.contains("People/_Heroes/")
    - party == link("Wiki/People/_Heroes/Best Friends Fight Team/Best Friends Fight Team")
formulas:
  Age: |+
    586-number(birth_year_GG)


  Species/Subspecies: if(!lineage.isEmpty(),lineage,species)
properties:
  formula.Species/Subspecies:
    displayName: Species
views:
  - type: table
    name: Best Friends Fight Team
    filters:
      and:
        - "!file.name.containsAny()"
    order:
      - file.name
      - name
      - surname
      - formula.Age
      - formula.Species/Subspecies
      - class
      - subclass
      - related_locations
      - related_persons
    columnSize:
      formula.Species/Subspecies: 118
      note.related_locations: 248
