filters:
  and:
    - '!file.path.containsAny("Codex", "DM")'
    - file.path.contains("_Heroes/Best Friends")
    - '!file.name.containsAny("Heroes", "Best")'
formulas:
  Age: |+
    586-number(birth_year_GG)


  Species/Subspecies: if(!subspecies.isEmpty(),subspecies,species)
views:
  - type: table
    name: Best Friends Fight Team
    order:
      - file.name
      - name
      - surname
      - formula.Age
      - formula.Species/Subspecies
      - class
      - subclass
      - related_locations
      - related_persons
    columnSize:
      formula.Species/Subspecies: 86
      note.related_locations: 248
